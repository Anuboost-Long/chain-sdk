<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The playground isn't `chain init`-managed, so this is its hand-written
     equivalent of package.json "chain.permissions" (see
     packages/cli/src/permissions.ts, which generates this file for apps). -->
<plist version="1.0">
<dict>
	<key>NSMicrophoneUsageDescription</key>
	<string>The playground records audio to prove microphone capture works.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>The playground transcribes recordings to prove on-device speech recognition works.</string>
</dict>
</plist>
