{
  "name": "@chain/sdk",
  "version": "0.1.0",
  "description": "Chain SDK — the public TypeScript API for the Chain desktop framework. Applications import this, never Tauri or native code directly.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "files": ["src"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "sync-contracts": "node scripts/sync-contracts.mjs",
    "prepare": "npm run sync-contracts",
    "prepublishOnly": "npm run sync-contracts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2"
  }
}
